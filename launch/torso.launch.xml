<launch>

  <arg name="use_sim_time" default="false"/>

  <group>
    <push-ros-namespace namespace="torso"/>

    <node pkg="torso" exec="torso_node" name="torso_node" output="screen">
      <param from="$(find-pkg-share torso)/config/torso.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

  </group>

</launch>
